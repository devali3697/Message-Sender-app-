<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:orientation="vertical"
    android:padding="20dp"
    tools:context=".ui.OnboardingActivity">

    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="32dp"
        android:contentDescription="App Icon"
        android:src="@android:drawable/ic_dialog_info"
        app:tint="?attr/colorPrimary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:text="Welcome to MessageSender"
        android:textAppearance="?attr/textAppearanceHeadlineMedium"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Complete these 2 quick setup steps to enable automatic 24/7 background SMS &amp; WhatsApp alert sync."
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="#666666" />

    <!-- Step 1 Card: SMS Permission -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="3dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Step 1: SIM SMS Permission"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStep1Status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#FFEBEE"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="REQUIRED"
                    android:textColor="#C62828"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Allows capturing SIM SMS messages directly from hardware even when phone is on DND or muted."
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="#555555" />

            <Button
                android:id="@+id/btnGrantSms"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Grant SMS Permission" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Step 2 Card: Notification Access -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="3dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Step 2: Notification Access (WhatsApp)"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStep2Status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#FFEBEE"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="REQUIRED"
                    android:textColor="#C62828"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Allows reading WhatsApp, Telegram, and app notification alerts to forward them to your second phone."
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="#555555" />

            <Button
                android:id="@+id/btnGrantNotifAccess"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Enable Notification Access" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Finish Setup Button -->
    <Button
        android:id="@+id/btnCompleteOnboarding"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Complete Setup &amp; Start Sync" />

</LinearLayout>